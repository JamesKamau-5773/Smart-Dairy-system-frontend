# Throwaway settings for running the backend against the isolated journey database
# (docker compose -p maziwa-journey, Postgres on :55439, Redis on :56380).
# Every key in backend/.env is set here so load_dotenv() can't fill one from the real file.
# Placeholders only: no real credentials.
export FLASK_APP=run:app
export FLASK_ENV=development
export APP_ENV=development
export SECRET_KEY=journey-secret-key-not-for-real-use-0123456789
export JWT_SECRET_KEY=journey-jwt-secret-key-not-for-real-use-0123456789
export BOOTSTRAP_SUPER_ADMIN_KEY=journey-bootstrap-key
export DATABASE_URL=postgresql+psycopg://maziwa:maziwa-dev@localhost:55439/maziwa
export TEST_DATABASE_URL=postgresql+psycopg://maziwa:maziwa-dev@localhost:55439/maziwa
export REDIS_URL=redis://localhost:56380/0
export CELERY_BROKER_URL=redis://localhost:56380/1
export CELERY_RESULT_BACKEND=redis://localhost:56380/2
export MPESA_ENVIRONMENT=sandbox
export MPESA_CONSUMER_KEY=
export MPESA_CONSUMER_SECRET=
export MPESA_BUSINESS_SHORTCODE=
export MPESA_PASSKEY=
export MPESA_CALLBACK_URL=
export WHATSAPP_APP_SECRET=
export WHATSAPP_VERIFY_TOKEN=
export WHATSAPP_ACCESS_TOKEN=
export WHATSAPP_PHONE_NUMBER_ID=
export CORS_ALLOWED_ORIGINS=http://localhost:5176
export FRONTEND_BASE_URL=http://localhost:5176
export UPLOAD_ROOT=/tmp/maziwa-journey-uploads
export FLASK_SKIP_DOTENV=1
